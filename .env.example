# ==============================================================
# VASUNDHARA Production Environment Configuration Example
# ==============================================================

# PostgreSQL Configuration
POSTGRES_DB=vasundhara
POSTGRES_USER=vasundhara
POSTGRES_PASSWORD=vasundhara_secret
POSTGRES_PORT=5432

# API Service Configuration
PORT=5000
DATABASE_URL=postgresql://vasundhara:vasundhara_secret@postgres:5432/vasundhara?schema=public
JWT_SECRET=vasundhara_super_secret_jwt_key_prod_2026
AI_SERVICE_URL=http://ai:8000
NODE_ENV=production

# Web Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# AI Service Configuration
AI_PORT=8000
