generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  CENTRAL_OFFICER
  STATE_OFFICER
  DISTRICT_OFFICER
  FIELD_OFFICER
}

enum ProjectStatus {
  PROPOSED
  UNDER_SCRUTINY
  APPROVED
  NOTIFIED
  ACQUISITION_IN_PROGRESS
  AWARD_DECLARED
  COMPENSATION_IN_PROGRESS
  POSSESSION_IN_PROGRESS
  R_AND_R_IN_PROGRESS
  COMPLETED
  CLOSED
  ON_HOLD
}

enum ParcelStatus {
  PROPOSED
  UNDER_SCRUTINY
  APPROVED
  NOTIFIED
  OBJECTION
  AWARD_DECLARED
  COMPENSATION_PENDING
  COMPENSATION_PAID
  POSSESSION_PENDING
  POSSESSION_COMPLETED
  R_AND_R_PENDING
  ACQUIRED
  REJECTED
}

enum WorkflowStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

enum WorkflowTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  BLOCKED
  CANCELLED
}

enum CompensationStatus {
  ASSESSED
  APPROVED
  PARTIALLY_PAID
  PAID
  PENDING
  REJECTED
}

enum PaymentStatus {
  PENDING
  APPROVED
  DISBURSED
  VERIFIED
  FAILED
}

enum PossessionStatus {
  ELIGIBLE
  VERIFICATION_PENDING
  VERIFIED
  POSSESSION_RECORDED
  COMPLETED
  REJECTED
}

enum RrStatus {
  ASSESSED
  APPROVED
  IN_PROGRESS
  VERIFICATION_PENDING
  COMPLETED
  CLOSED
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}


// ============================================================
// ORGANIZATION / JURISDICTION
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  states State[]

  @@index([name])
  @@map("organizations")
}

model State {
  id             String       @id @default(cuid())
  name           String
  code           String       @unique
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  districts    District[]
  users        User[]
  projects     Project[]

  @@index([organizationId])
  @@index([name])
  @@map("states")
}

model District {
  id        String   @id @default(cuid())
  name      String
  code      String
  stateId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state    State    @relation(fields: [stateId], references: [id])
  users    User[]
  projects Project[]

  @@unique([stateId, code])
  @@index([stateId])
  @@index([name])
  @@map("districts")
}


// ============================================================
// USERS
// ============================================================

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role
  organizationId String?
  stateId        String?
  districtId     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  state        State?        @relation(fields: [stateId], references: [id])
  district     District?     @relation(fields: [districtId], references: [id])

  assignedTasks       WorkflowTask[]      @relation("TaskAssignee")
  notifications       Notification[]
  auditLogs           AuditLog[]
  uploadedDocuments   Document[]          @relation("DocumentUploader")
  possessionRecords   PossessionRecord[]  @relation("PossessionOfficer")

  @@index([organizationId])
  @@index([stateId])
  @@index([districtId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}


// ============================================================
// PROJECTS
// ============================================================

model Project {
  id          String        @id @default(cuid())
  name        String
  code        String        @unique
  description String?
  status      ProjectStatus @default(PROPOSED)

  stateId    String
  districtId String

  proposedArea Decimal? @db.Decimal(18, 4)

  proposalDate DateTime?
  approvalDate DateTime?
  closureDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state    State    @relation(fields: [stateId], references: [id])
  district District @relation(fields: [districtId], references: [id])

  parcels           LandParcel[]
  workflowInstances WorkflowInstance[]
  milestones        Milestone[]
  affectedFamilies  AffectedFamily[]
  compensationCases CompensationCase[]
  possessionRecords PossessionRecord[]
  rrCases           RrCase[]
  documents         Document[]
  auditLogs         AuditLog[]

  @@index([stateId])
  @@index([districtId])
  @@index([status])
  @@index([name])
  @@map("projects")
}


// ============================================================
// LAND PARCELS
// ============================================================

model LandParcel {
  id          String       @id @default(cuid())
  projectId   String
  parcelNumber String
  surveyNumber String?
  village     String?
  tehsil      String?
  area        Decimal?     @db.Decimal(18, 4)
  status      ParcelStatus @default(PROPOSED)

  // PostGIS spatial field.
  // Actual geometry type/SRID/index will be configured through
  // a PostgreSQL migration because Prisma does not fully model
  // PostGIS spatial types.
  geometry Unsupported("geometry")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  familyParcels      FamilyParcel[]
  compensationCases  CompensationCase[]
  possessionRecords  PossessionRecord[]
  documents          Document[]
  auditLogs          AuditLog[]

  @@unique([projectId, parcelNumber])
  @@index([projectId])
  @@index([status])
  @@map("land_parcels")
}


// ============================================================
// AFFECTED FAMILIES
// ============================================================

model AffectedFamily {
  id        String   @id @default(cuid())
  projectId String

  familyReference String  @unique
  headOfFamily    String?
  contactNumber   String?
  address         String?

  numberOfMembers Int?
  displaced       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  parcels           FamilyParcel[]
  compensationCases CompensationCase[]
  rrCases           RrCase[]
  documents         Document[]
  auditLogs         AuditLog[]

  @@index([projectId])
  @@index([displaced])
  @@map("affected_families")
}


// Many-to-many relationship between families and parcels.
model FamilyParcel {
  id       String @id @default(cuid())
  familyId String
  parcelId String

  affectedArea Decimal? @db.Decimal(18, 4)

  createdAt DateTime @default(now())

  family AffectedFamily @relation(fields: [familyId], references: [id])
  parcel LandParcel    @relation(fields: [parcelId], references: [id])

  @@unique([familyId, parcelId])
  @@index([familyId])
  @@index([parcelId])
  @@map("family_parcels")
}


// ============================================================
// WORKFLOW
// ============================================================

model WorkflowInstance {
  id        String         @id @default(cuid())
  projectId String
  currentStage String
  status    WorkflowStatus @default(NOT_STARTED)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  tasks   WorkflowTask[]

  @@index([projectId])
  @@index([status])
  @@index([currentStage])
  @@map("workflow_instances")
}

model WorkflowTask {
  id         String             @id @default(cuid())
  workflowId String
  stage      String
  title      String

  assignedToId String?
  deadline     DateTime?

  status      WorkflowTaskStatus @default(PENDING)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflow   WorkflowInstance @relation(fields: [workflowId], references: [id])
  assignedTo User?            @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@index([workflowId])
  @@index([assignedToId])
  @@index([status])
  @@index([deadline])
  @@map("workflow_tasks")
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  name      String
  stage     String

  dueDate      DateTime?
  completedAt  DateTime?
  isCompleted  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([dueDate])
  @@map("milestones")
}


// ============================================================
// COMPENSATION
// ============================================================

model CompensationCase {
  id        String @id @default(cuid())
  projectId String
  parcelId  String
  familyId  String

  assessedAmount Decimal @default(0) @db.Decimal(18, 2)
  approvedAmount Decimal @default(0) @db.Decimal(18, 2)
  paidAmount     Decimal @default(0) @db.Decimal(18, 2)
  pendingAmount  Decimal @default(0) @db.Decimal(18, 2)

  status        CompensationStatus @default(ASSESSED)
  paymentStatus PaymentStatus      @default(PENDING)

  awardDate   DateTime?
  paymentDate DateTime?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id])
  parcel  LandParcel     @relation(fields: [parcelId], references: [id])
  family  AffectedFamily @relation(fields: [familyId], references: [id])

  documents Document[]
  auditLogs AuditLog[]

  @@index([projectId])
  @@index([parcelId])
  @@index([familyId])
  @@index([status])
  @@index([paymentStatus])
  @@map("compensation_cases")
}


// ============================================================
// POSSESSION
// ============================================================

model PossessionRecord {
  id        String @id @default(cuid())
  projectId String
  parcelId  String

  fieldOfficerId String?

  status PossessionStatus @default(ELIGIBLE)

  // GPS coordinates for field evidence.
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  evidenceUrl String?
  remarks     String?

  verifiedAt  DateTime?
  recordedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project     @relation(fields: [projectId], references: [id])
  parcel       LandParcel  @relation(fields: [parcelId], references: [id])
  fieldOfficer User?       @relation("PossessionOfficer", fields: [fieldOfficerId], references: [id])

  documents Document[]
  auditLogs AuditLog[]

  @@index([projectId])
  @@index([parcelId])
  @@index([fieldOfficerId])
  @@index([status])
  @@map("possession_records")
}


// ============================================================
// REHABILITATION & RESETTLEMENT
// ============================================================

model RrCase {
  id        String @id @default(cuid())
  projectId String
  familyId  String

  status RrStatus @default(ASSESSED)

  housingSupport          Boolean @default(false)
  financialAssistance     Boolean @default(false)
  employmentSupport       Boolean @default(false)
  relocationSupport       Boolean @default(false)

  benefitsDescription String?

  assessedAt   DateTime?
  completedAt  DateTime?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id])
  family  AffectedFamily @relation(fields: [familyId], references: [id])

  documents Document[]
  auditLogs AuditLog[]

  @@index([projectId])
  @@index([familyId])
  @@index([status])
  @@map("rr_cases")
}


// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id String @id @default(cuid())

  projectId String?

  parcelId       String?
  familyId       String?
  compensationId String?
  possessionId   String?
  rrCaseId       String?

  uploadedById String?

  name        String
  storageKey  String
  mimeType    String?
  sizeBytes   BigInt?

  status DocumentStatus @default(UPLOADED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project?          @relation(fields: [projectId], references: [id])
  parcel       LandParcel?       @relation(fields: [parcelId], references: [id])
  family       AffectedFamily?   @relation(fields: [familyId], references: [id])
  compensation CompensationCase? @relation(fields: [compensationId], references: [id])
  possession   PossessionRecord? @relation(fields: [possessionId], references: [id])
  rrCase       RrCase?           @relation(fields: [rrCaseId], references: [id])
  uploadedBy   User?             @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([parcelId])
  @@index([familyId])
  @@index([compensationId])
  @@index([possessionId])
  @@index([rrCaseId])
  @@index([uploadedById])
  @@index([status])
  @@map("documents")
}


// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id     String @id @default(cuid())
  userId String

  title   String
  message String

  status NotificationStatus @default(PENDING)

  readAt   DateTime?
  sentAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}


// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  projectId       String?
  parcelId        String?
  familyId        String?
  compensationId  String?
  possessionId    String?
  rrCaseId        String?

  action      String
  entityType  String
  entityId    String?

  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  user         User?             @relation(fields: [userId], references: [id])
  project      Project?          @relation(fields: [projectId], references: [id])
  parcel       LandParcel?       @relation(fields: [parcelId], references: [id])
  family       AffectedFamily?   @relation(fields: [familyId], references: [id])
  compensation CompensationCase? @relation(fields: [compensationId], references: [id])
  possession   PossessionRecord? @relation(fields: [possessionId], references: [id])
  rrCase       RrCase?           @relation(fields: [rrCaseId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([parcelId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}